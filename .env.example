# Copy to .env and fill in - docker-compose reads these automatically.
# Missing values are fine for everything except the feature that needs them.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# Odoo integration [moved to DB now]
# ODOO_BASE_URL: your Odoo instance URL, e.g. https://mycompany.odoo.com
# ODOO_API_KEY:  generate from Odoo → Settings → Users → your user → API Keys
ODOO_BASE_URL=
ODOO_API_KEY=

# ---------------------------------------------------------------------------
# Database backup (deployment/db-backup). Everything here is OPTIONAL;
# uncomment a line only to change the default shown.
# ---------------------------------------------------------------------------
# Master switch. false = backup and restore scripts do nothing.
# DB_BACKUP_ENABLED=true
# Host folder for backup files (outside docker, so it survives container rebuilds).
# DB_BACKUP_DIR=/backups/waha
# Backups older than this many days are deleted, but only after a new backup succeeded.
# DB_BACKUP_RETENTION_DAYS=5
# Daily backup time in UTC, 24h HH:MM. 01:00 UTC = 04:00 Riyadh (after the 03:00 Odoo session switch).
# After changing it, run deployment/db-backup/install-cron.sh again.
# DB_BACKUP_TIME=01:00
# Refuse to start a backup if the backup disk has less free space than this (MB).
# DB_BACKUP_MIN_FREE_MB=1024
